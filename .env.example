# Solo desarrollo local. Copiar a .env y completar secretos.
DATABASE_URL=postgresql://habita:CHANGE_ME@127.0.0.1:5433/habita?schema=public
DIRECT_URL=postgresql://habita:CHANGE_ME@127.0.0.1:5433/habita?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
